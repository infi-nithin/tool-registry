# Tool Registry - Environment Configuration
# Copy this file to .env and update the values with your actual configuration

# =============================================================================
# Database Configuration
# =============================================================================

# Full async database URL (optional - will be constructed from components if not provided)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://tool_registry_user:your_secure_password@localhost:5432/tool_registry

# Database connection components (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tool_registry
DB_USER=tool_registry_user
DB_PASSWORD=your_secure_password

# Connection pooling settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Default main MCP server name
MAIN_SERVER_NAME=main-mcp-server

# Timeout for OpenAPI spec fetching (seconds)
SPEC_FETCH_TIMEOUT=30
